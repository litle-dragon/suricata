# Geo (RU/BY/CN/KP/IR) + Spamhaus DROP blocking via Suricata IP Reputation (iprep).
# See README.md Step 4b and PROJECT_HISTORY.md (ADR-0003)
# (supersedes ADR-0001: Suricata `dataset type: ip` is exact-match only and
# rejects CIDR entries -- confirmed on a live 7.0.3 box. iprep is the CIDR-aware
# mechanism: its reputation-file format natively accepts CIDR notation).
#
# Requires reputation-categories-file / reputation-files configured in suricata.yaml
# (README Step 4b), with category short names GEO-RU/GEO-BY/GEO-CN/GEO-KP/GEO-IR/SPAMHAUS
# generated by update_geo_lists.py.
#
# `msg` is a load-bearing contract, not free text: alert-bridge.py's classify_category()
# parses this exact prefix to route these alerts into the geo/Spamhaus pipeline
# (immediate + permanent block, no escalation) instead of the ordinary ET pipeline.
# Do not rename `msg` without updating classify_category() in alert-bridge.py to match.
#
# sid range 9000001-9000012 is reserved for this feature -- outside the ET range,
# never touched by `suricata-update`.

alert ip $EXTERNAL_NET any -> $HOME_NET any (msg:"GEO-BLOCK-RU-IN"; iprep:src,GEO-RU,>,0; classtype:policy-violation; sid:9000001; rev:2;)
alert ip $HOME_NET any -> $EXTERNAL_NET any (msg:"GEO-BLOCK-RU-OUT"; iprep:dst,GEO-RU,>,0; classtype:policy-violation; sid:9000002; rev:2;)
alert ip $EXTERNAL_NET any -> $HOME_NET any (msg:"GEO-BLOCK-BY-IN"; iprep:src,GEO-BY,>,0; classtype:policy-violation; sid:9000003; rev:2;)
alert ip $HOME_NET any -> $EXTERNAL_NET any (msg:"GEO-BLOCK-BY-OUT"; iprep:dst,GEO-BY,>,0; classtype:policy-violation; sid:9000004; rev:2;)
alert ip $EXTERNAL_NET any -> $HOME_NET any (msg:"GEO-BLOCK-CN-IN"; iprep:src,GEO-CN,>,0; classtype:policy-violation; sid:9000005; rev:2;)
alert ip $HOME_NET any -> $EXTERNAL_NET any (msg:"GEO-BLOCK-CN-OUT"; iprep:dst,GEO-CN,>,0; classtype:policy-violation; sid:9000006; rev:2;)
alert ip $EXTERNAL_NET any -> $HOME_NET any (msg:"GEO-BLOCK-KP-IN"; iprep:src,GEO-KP,>,0; classtype:policy-violation; sid:9000007; rev:2;)
alert ip $HOME_NET any -> $EXTERNAL_NET any (msg:"GEO-BLOCK-KP-OUT"; iprep:dst,GEO-KP,>,0; classtype:policy-violation; sid:9000008; rev:2;)
alert ip $EXTERNAL_NET any -> $HOME_NET any (msg:"GEO-BLOCK-IR-IN"; iprep:src,GEO-IR,>,0; classtype:policy-violation; sid:9000009; rev:2;)
alert ip $HOME_NET any -> $EXTERNAL_NET any (msg:"GEO-BLOCK-IR-OUT"; iprep:dst,GEO-IR,>,0; classtype:policy-violation; sid:9000010; rev:2;)
alert ip $EXTERNAL_NET any -> $HOME_NET any (msg:"SPAMHAUS-BLOCK-IN"; iprep:src,SPAMHAUS,>,0; classtype:policy-violation; sid:9000011; rev:2;)
alert ip $HOME_NET any -> $EXTERNAL_NET any (msg:"SPAMHAUS-BLOCK-OUT"; iprep:dst,SPAMHAUS,>,0; classtype:policy-violation; sid:9000012; rev:2;)
