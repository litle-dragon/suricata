# Telegram — fill in after creating a bot with @BotFather, then:
# systemctl restart alert-bridge
TG_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TG_CHAT=YOUR_CHAT_ID
# MikroTik REST API — your router's LAN IP and the dedicated API user
# created in README Step 8b.
MT_HOST=YOUR_ROUTER_LAN_IP
MT_USER=suricata
MT_PASS=YOUR_MIKROTIK_PASSWORD
# Our own public IPs (CIDR) — added to the whitelist and HOME_NETS so the
# bridge never blocks itself and can tell which side of a flow is the attacker.
# Find them: curl -4 ifconfig.me / curl -6 ifconfig.me
# e.g. WAN_IP=203.0.113.1/32  WAN_IPV6_PREFIX=2001:db8:aaaa:1::/64
# (leave empty if you have no IPv6 — an unreplaced placeholder here would
# crash the bridge, so these ship blank)
WAN_IP=
WAN_IPV6_PREFIX=
